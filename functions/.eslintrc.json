{
    "env": {
        "commonjs": true,
        "es2021": true,
        "node": true
    },
    "extends": ["eslint:recommended"],
    "parserOptions": {
        "ecmaVersion": 2021
    },
    "rules": {
        "quotes": ["error", "double"],
        "semi": ["error", "always"],
        "no-unused-vars": ["warn", { "args": "none" }]
    }
}
